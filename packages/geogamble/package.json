{
  "name": "geogamble",
  "version": "2026.11.19",
  "private": true,
  "type": "module",
  "description": "GeoGuessr country gambling and per-round location case userscript",
  "scripts": {
    "build": "node ../../tooling/build-userscript.mjs geogamble",
    "build:check": "node ../../tooling/build-userscript.mjs geogamble --check",
    "dev": "node ../../tooling/dev-server.mjs geogamble",
    "test": "tsx --test --test-force-exit tests/*.test.mjs",
