    "island-tool": "node scripts/island-tool.mjs",
    "hint-data": "node scripts/generate-hint-data.mjs",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "koppen-climate-lookup": "^2.0.0"
  },
  "dependencies": {
    "gg-kit": "*"
  }
